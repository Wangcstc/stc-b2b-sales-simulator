{
  "name": "stc-b2b-sales-simulator",
  "version": "8.9.7",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "stc-b2b-sales-simulator（STC 外贸业务沙盘 · 询盘演练系统）：柜子（网站）+ 抽屉（题库加工）+ 标准层 + 题库工具包",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wangcstc/stc-b2b-sales-simulator.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev -p 3100",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "lint:l-word": "tsx scripts/lint-l-word.ts",
    "check:isolation": "tsx scripts/check-isolation.ts",
    "check:engine": "tsx scripts/check-engine-purity.ts",
    "check:readiness": "tsx scripts/check-readiness.ts",
    "check:fidelity": "tsx scripts/import/verify-fidelity.ts",
    "check:fidelity:strict": "tsx scripts/import/verify-fidelity.ts --strict",
    "check:bg": "tsx scripts/import/verify-bg.ts",
    "check:difficulty": "tsx scripts/import/autoplay.ts --report",
    "check:ledger": "tsx scripts/check-ledger-audit.ts",
    "check:syllabus": "tsx scripts/check-syllabus.ts",
    "smoke:turn": "tsx scripts/smoke-turn.ts",
    "backup": "tsx scripts/backup-db.ts",
    "backup:verify": "tsx scripts/backup-db.ts verify",
    "build:v3-calibration-pool": "tsx scripts/import/build-v3-calibration-pool.ts --apply",
    "verify": "npm run test && npm run lint:l-word && npm run check:isolation && npm run check:engine && npm run check:boundaries && npm run check:syllabus-doc && npm run check:bank-format-doc && npm run check:samples && npm run check:version && npm run check:blacklist",
    "import:chat": "tsx scripts/import-chat.ts",
    "ledger": "tsx scripts/import/build-ledger.ts",
    "verify:persona": "tsx scripts/import/verify-persona.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:clean": "tsx scripts/seed-demo.ts --clean",
    "check:version": "tsx scripts/check-version.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "gen:syllabus-doc": "tsx scripts/gen-syllabus-doc.ts",
    "check:syllabus-doc": "tsx scripts/gen-syllabus-doc.ts --check",
    "gen:bank-format-doc": "tsx scripts/gen-bank-format-doc.ts",
    "check:bank-format-doc": "tsx scripts/gen-bank-format-doc.ts --check",
    "gen:templates": "tsx scripts/gen-templates.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "bank": "tsx scripts/bank.ts",
    "drawer": "tsx scripts/drawer.ts",
    "samples:build": "tsx scripts/build-samples.ts",
    "check:samples": "tsx scripts/build-samples.ts --check",
    "check:blacklist": "tsx scripts/check-blacklist.ts",
    "hooks:install": "tsx scripts/install-hooks.ts",
    "release:check": "tsx scripts/release-check.ts",
    "release:export": "tsx scripts/release-export.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "^15.5.0",
    "node-cron": "^4.6.0",
    "openai": "^4.67.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "node-html-parser": "^9.0.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
