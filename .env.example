# 复制为 .env 后填写。.env 不进 git。
# 部署到线上时，同一套值要在托管平台或服务器的环境变量里再配一遍（少一个都起不来）。

# --- DeepSeek（OpenAI 兼容协议） ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com

# --- 各用途模型名分开配置（技术方案 2.3 约束①：换模型成本必须为零） ---
MODEL_EXTRACT=deepseek-v4-flash
MODEL_TRANSLATE=deepseek-v4-flash
MODEL_ROLEPLAY=deepseek-v4-flash
MODEL_COACH_QA=deepseek-v4-pro
MODEL_SCORE=deepseek-v4-pro

# --- 单价（元/百万 token），填**空闲时段**价格 ---
# 下面是 2026-11-06 抄自 DeepSeek 官网价格页（api-docs.deepseek.com/zh-cn/quick_start/pricing）的空闲时段价，
# 价格会变，定期去官网核对。这六个名字必须和代码一致，写错了成本台账会一直是 0 而且不报错
PRICE_FLASH_IN_HIT=0.02
PRICE_FLASH_IN_MISS=1
PRICE_FLASH_OUT=4
PRICE_PRO_IN_HIT=0.15
PRICE_PRO_IN_MISS=4.5
PRICE_PRO_OUT=13.5
# 高峰时段倍数：DeepSeek 北京时间工作日 9:00–12:00、14:00–18:00 单价翻倍，填 2；没有峰谷的服务商留空
PRICE_PEAK_MULTIPLIER=2

# --- 数据库 ---
# 线上用云数据库时建议填连接池串（如 Neon 主机名带 -pooler 的那个），serverless 直连容易把连接数吃满
# 本地填 docker compose 起的库：postgresql://drill:drill_local_dev@localhost:5433/drill?schema=public
DATABASE_URL="postgresql://drill:drill_local_dev@localhost:5433/drill?schema=public"

# 会话令牌签名密钥，至少 32 位随机串：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# /api/admin/bootstrap（建表+灌人设）的令牌，32 位随机串：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 不配 = 该接口返回 503 自动禁用。代码里没有默认值，这是故意的：
# 有默认值等于这个接口对全网敞开，任何人都能重灌人设库。
BOOTSTRAP_TOKEN=""

# --- v3.0 权限生效模式 ---
# false = 准入结果直接生效；需要紧急冻结自动权限时可临时改为 true。
V3_SHADOW_MODE=false

# ★ v1.1 每晚结算的定时任务口令 ★
# 定时任务（托管平台的 Cron 或服务器 crontab）带 Authorization: Bearer $CRON_SECRET 调 /api/settlement。
# 不设也能跑（首页与账号管理页会补算），但补算依赖有人打开页面——正式环境请设。
CRON_SECRET=

# ★ V3_SHADOW_MODE 从 v1.1 起只影响 v3.0 遗留的准入路径 ★
# v1.1 的期别切换在每晚结算当场写入 User.stage，不再受这个开关影响。

# --- 备份（npm run backup / npm run backup:verify）---
# ★ 要备线上库就填这一个，别去改上面的 DATABASE_URL ★
# 改 DATABASE_URL 等于让本地开发直接连上线上库——那是另一类事故，而且不会有任何提示。
# 串从哪儿拿：云数据库控制台的连接串（**要直连那个，不要连接池串**）
# 不填就备 DATABASE_URL 指向的库（本地开发库）。
BACKUP_DATABASE_URL=
# 备份放哪儿。默认是仓库外面的 ../_数据库备份
BACKUP_DIR=
# 留最近几份，默认 30
BACKUP_KEEP=

# --- 模型用量预算闸 ---
# ★ 它防的是跑飞，不是限制正常使用 ★
# 到 70% 在服务端日志打一条 warn（业务员无感），到 100% 才拒绝新的对话。
# 默认 5,000,000 tokens/天：按 7 人 × 6 局 × 约 45 次调用 ≈ 230 万估算，
# 留了一倍余量。团队规模变了改这里，别去改代码。
# 填 0 = 显式关掉这道闸（只建议本地调试用）。
LLM_DAILY_TOKEN_BUDGET=

# --- 题池门槛（选填）---
# 默认值在 standards/pool-requirements.json：练习池有 1 道就能练（不设下限），考试每个槽位 ≥14 道且 ≥4 个题型。
# ★ 只在演示或试用时调低 ★ 例如只装了样品题库时，考试两项都填 1 才能开考。正式使用请留空。
POOL_DRILL_MIN_QUESTIONS=
POOL_EXAM_SLOT_MIN_QUESTIONS=
POOL_EXAM_SLOT_MIN_TYPES=

# --- 抽屉（题库加工，npm run drawer）---
# 工作区：原材料副本、脱敏素材、加工中的题、确认卡都放这里。默认 workspace/drawer/（已在 .gitignore 里）
DRAWER_DIR=
# 本批脱敏词表文件（一行一个词，# 后是注释）：自家公司中英文名、品牌名、业务员英文名和小名、工厂所在城市。
# 正则抓不到这些，只能列出来。文件放在不进仓库的地方；配了以后每次投料自动带上，命令行 --mask-file 可临时换
DRAWER_MASK_FILE=
# 题库工坊开几页（选填）：full＝投料、加工、确认、题库、覆盖全开（常驻服务器默认）；
# bank-only＝只开题库与覆盖（托管平台：硬盘是临时的，加工跑不了）。Vercel 上自动是 bank-only
WORKSHOP_MODE=
# 客户黑名单（选填）：提交前扫仓库用（npm run check:blacklist、npm run hooks:install 装的钩子）。没配就用 DRAWER_MASK_FILE
BLACKLIST_FILE=
# 各工序的模型（留空用默认）：归型用 flash 就够，起草、变体、修订用 pro
DRAWER_MODEL_TRIAGE=
DRAWER_MODEL_DRAFT=
DRAWER_MODEL_VARIANT=
# 抽屉的花费按上面 PRICE_FLASH_* / PRICE_PRO_* 折算，高峰时段乘 PRICE_PEAK_MULTIPLIER；没填单价时只统计 token，预算闸不生效
